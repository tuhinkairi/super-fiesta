# Backend MongoDB
DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DB_NAME=fiesta

# Shared Google Gemini credentials and default model
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROJECT_ID=demo-story

# Model routing for the AI modules
STORY_MODEL=gemini-3.8-flash
INSPIRATION_MODEL=gemini-3.8-flash
SUGGESTION_MODEL=gemini-3.8-flash
ARTIST_GRAPH_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# Artist Graph RAG (Neo4j Aura)
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
LLM_PROVIDER=gemini

# Context-Aware Suggestion vector database
PINECONE_API_KEY=your_pinecone_api_key
CASR_RETRIEVAL_RERANKING_ENABLED=false
CASR_RETRIEVAL_RERANKER_PROVIDER=none
CASR_RETRIEVAL_RERANKER_MODEL=
CASR_TREND_NEWS_RSS_FEEDS=["https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en","https://news.google.com/rss/search?q=artificial+intelligence&hl=en-IN&gl=IN&ceid=IN:en","https://news.google.com/rss/search?q=cybersecurity&hl=en-IN&gl=IN&ceid=IN:en","https://feeds.bbci.co.uk/news/technology/rss.xml"]

# Inspiration Ingestion
MAX_FILE_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
