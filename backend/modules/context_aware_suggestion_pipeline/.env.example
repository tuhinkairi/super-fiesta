# Application
CASR_ENVIRONMENT=development
CASR_DEBUG=false
CASR_LOG_LEVEL=INFO

# Content preferences
CASR_DEFAULT_LANGUAGE=en
CASR_DEFAULT_REGION=IN

# Timezone
CASR_TIMEZONE=Asia/Kolkata

# Document processing
CASR_MAX_DOCUMENT_SIZE_MB=20

# Cache
CASR_CACHE_ENABLED=true
CASR_CACHE_TTL_SECONDS=3600

# ============================================================
# Gemini LLM Configuration
# ============================================================

# Authentication
# Shared credentials and model IDs are configured in the repository-root .env.

# Model
# SUGGESTION_MODEL is configured in the repository-root .env.

# Generation
CASR_LLM_TEMPERATURE=0.7
CASR_LLM_MAX_OUTPUT_TOKENS=4096
CASR_LLM_TOP_P=0.95
CASR_LLM_TOP_K=40

# Request settings
CASR_LLM_TIMEOUT_SECONDS=60
CASR_LLM_MAX_RETRIES=3

# Output
CASR_LLM_RESPONSE_MIME_TYPE=text/plain

# ============================================================
# Pinecone Configuration
# ============================================================

# Authentication
PINECONE_API_KEY=

# Index
CASR_PINECONE_INDEX_NAME=context-aware-suggestion-index
CASR_PINECONE_DIMENSION=768
CASR_PINECONE_METRIC=dotproduct

# Serverless
CASR_PINECONE_CLOUD=aws
CASR_PINECONE_REGION=us-east-1

# Index management
CASR_PINECONE_CREATE_INDEX_IF_MISSING=true
CASR_PINECONE_DELETION_PROTECTION=disabled

# Connection
CASR_PINECONE_TIMEOUT_SECONDS=30
CASR_PINECONE_MAX_RETRIES=3

# ============================================================
# Embedding Configuration
# ============================================================

# Dense embeddings
CASR_EMBEDDING_DENSE_PROVIDER=google
CASR_EMBEDDING_DENSE_MODEL=gemini-embedding-001
CASR_EMBEDDING_DENSE_DIMENSION=768
CASR_EMBEDDING_NORMALIZE_DENSE_EMBEDDINGS=true

# Sparse embeddings
CASR_EMBEDDING_SPARSE_PROVIDER=bm25
CASR_EMBEDDING_SPARSE_MODEL=pinecone-sparse-english-v0

# Batch processing
CASR_EMBEDDING_BATCH_SIZE=32
CASR_EMBEDDING_MAX_INPUT_TOKENS=20000

# Retry
CASR_EMBEDDING_MAX_RETRIES=3

# ============================================================
# Retrieval Configuration
# ============================================================

# Strategy
CASR_RETRIEVAL_RETRIEVAL_STRATEGY=hybrid

# Hybrid weights
CASR_RETRIEVAL_DENSE_WEIGHT=0.7
CASR_RETRIEVAL_SPARSE_WEIGHT=0.3

# Retrieval limits
CASR_RETRIEVAL_INITIAL_TOP_K=30
CASR_RETRIEVAL_FINAL_TOP_K=10
CASR_RETRIEVAL_MINIMUM_RELEVANCE_SCORE=0.0

# Reranking
CASR_RETRIEVAL_RERANKING_ENABLED=true
CASR_RETRIEVAL_RERANKER_PROVIDER=cohere
CASR_RETRIEVAL_RERANKER_MODEL=rerank-v3.5
CASR_RETRIEVAL_RERANKER_TOP_N=10

# Result fusion
CASR_RETRIEVAL_FUSION_STRATEGY=weighted_score
CASR_RETRIEVAL_RECIPROCAL_RANK_CONSTANT=60

# Metadata filtering
CASR_RETRIEVAL_METADATA_FILTERING_ENABLED=true
CASR_RETRIEVAL_ENFORCE_SOURCE_FILTER=true
CASR_RETRIEVAL_ENFORCE_EXPIRY_FILTER=true

# Source-specific retrieval
CASR_RETRIEVAL_FETCH_DOCUMENT_RESULTS=10
CASR_RETRIEVAL_FETCH_TREND_RESULTS=10
CASR_RETRIEVAL_FETCH_NEWS_RESULTS=10
# Google Trends
CASR_TREND_TRENDS_ENABLED=true
CASR_TREND_TRENDS_PROVIDER=google_trends
CASR_TREND_TRENDS_REGION=IN
CASR_TREND_TRENDS_LANGUAGE=en-US
CASR_TREND_TRENDS_TIMEFRAME=now 7-d
CASR_TREND_TRENDS_CATEGORY=0
CASR_TREND_TRENDS_MAX_RESULTS=20
CASR_TREND_TRENDS_REFRESH_INTERVAL_SECONDS=3600
CASR_TREND_TRENDS_REQUEST_TIMEOUT_SECONDS=30
CASR_TREND_TRENDS_MAX_RETRIES=3
CASR_TREND_TRENDS_MIN_REQUEST_INTERVAL_SECONDS=2.0

# News collection
CASR_TREND_NEWS_ENABLED=true
CASR_TREND_NEWS_PROVIDER=rss
CASR_TREND_NEWS_RSS_FEEDS=["https://news.google.com/rss?hl=en-IN&gl=IN&ceid=IN:en","https://news.google.com/rss/search?q=artificial+intelligence&hl=en-IN&gl=IN&ceid=IN:en","https://news.google.com/rss/search?q=cybersecurity&hl=en-IN&gl=IN&ceid=IN:en","https://feeds.bbci.co.uk/news/technology/rss.xml"]
CASR_TREND_NEWS_MAX_ITEMS=30
CASR_TREND_NEWS_LOOKBACK_HOURS=72
CASR_TREND_NEWS_REFRESH_INTERVAL_SECONDS=1800
CASR_TREND_NEWS_REQUEST_TIMEOUT_SECONDS=20
CASR_TREND_NEWS_MAX_RETRIES=3
CASR_TREND_NEWS_MIN_REQUEST_INTERVAL_SECONDS=1.0
CASR_TREND_NEWS_USER_AGENT=ContextAwareSuggestionRAG/0.1
